# Server Security Configuration
PORT=3001
NODE_ENV=development

# Google Cloud & Secret Manager
# If running in GCP, Secret Manager resolves secrets automatically with IAM permissions.
# In local development, you can provide GEMINI_API_KEY directly here for the server.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Firebase Admin Configuration (Optional for production verification)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_SERVICE_ACCOUNT_KEY={"type": "service_account", ...}

# Client Vite Configuration (Prefix with VITE_)
# Notice: NEVER put GEMINI_API_KEY in VITE_ variables! It is kept strictly on the backend.
VITE_FIREBASE_API_KEY=your_firebase_client_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_API_URL=http://localhost:3001
